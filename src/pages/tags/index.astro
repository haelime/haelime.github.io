---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { taxonomySlug } from '../../lib/portfolio';

const projects = (await getCollection('portfolio')).filter((project) => !project.data.unlisted);
const tags = [...new Set(projects.flatMap((project) => project.data.tags))].sort((a, b) => a.localeCompare(b));
---

<BaseLayout title="태그">
  <article class="page-shell">
    <header class="page-header"><p class="eyebrow">Taxonomy</p><h1>태그</h1></header>
    <div class="taxonomy-list">
      {tags.map((tag) => <a href={`/tags/${taxonomySlug(tag)}/`}>{tag}</a>)}
    </div>
  </article>
</BaseLayout>
