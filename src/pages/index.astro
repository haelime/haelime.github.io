---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { visibleProjects } from '../lib/portfolio';

const projects = visibleProjects(await getCollection('portfolio'), false);
const games = projects.filter((project) => project.data.project_group === 'games');
const graphics = projects.filter((project) => project.data.project_group === 'graphics');
const general = projects.filter((project) => project.data.project_group === 'general');
---

<BaseLayout>
  <section>
    <h1 class="section-title">프로필</h1>
    <div class="profile-intro">
      <img src="/assets/img/IMG_8923.jpg" alt="Hae Eem 프로필 사진" />
      <div>
        <h2>Hae Eem</h2>
        <p>C++ / C# 프로그래머입니다.</p>
        <div class="profile-links">
          <a href="https://github.com/haelime" target="_blank" rel="noreferrer">GitHub</a>
          <a href="mailto:loreminder@gmail.com">이메일</a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <h2 class="section-title">경력</h2>
    <div class="group-intro prose">
      <h3>웨어러블에이아이</h3>
      <p><strong>시스템 소프트웨어 엔지니어 / 주임연구원</strong> (2024.11–2025.04)</p>
      <p>인천국제공항 자율주행 셔틀 프로젝트에서 UDP 기반 LiDAR 데이터 처리, C++/ROS2 기반 FSM 제어 로직, 생존 신호 기반 진단 및 고장 안전 시스템을 개발했습니다.</p>
    </div>
    <ProjectGrid projects={general} />
  </section>

  <section>
    <h2 class="section-title">교육</h2>
    <div class="group-intro prose">
      <h3>École 42</h3>
      <p><strong>42 Seoul 과정 수료</strong> (2022.11–2024.11)</p>
      <p>2년간 2,633시간 이상 오프라인으로 참여해 시스템 레벨 프로그래밍 중심의 자기주도적 동료 학습 프로젝트를 수행했습니다.</p>
      <ul>
        <li>C/C++ 기반 저수준 프로그래밍, 운영체제와 시스템 구조</li>
        <li>성능 최적화, UNIX 시스템 관리와 네트워크 인프라</li>
        <li>110회 이상의 동료 평가를 통한 코드 분석과 기술 피드백</li>
      </ul>
    </div>
  </section>

  <section>
    <h2 class="section-title">기술</h2>
    <div class="group-intro prose">
      <ul>
        <li>언어: <code>C++</code> <code>C#</code> <code>Python</code> <code>GLSL</code> <code>Shell</code></li>
        <li>게임: <code>Unity</code></li>
        <li>그래픽스: <code>컴퓨트 셰이더</code> <code>광선 추적</code> <code>3차원 그래픽스</code></li>
        <li>시스템과 도구: <code>ROS2</code> <code>Linux</code> <code>CMake</code> <code>Git</code></li>
      </ul>
    </div>
  </section>

  <section>
    <h2 class="section-title">프로젝트 · 게임</h2>
    <ProjectGrid projects={games} />
    <h2 class="section-title">프로젝트 · 그래픽스</h2>
    <ProjectGrid projects={graphics} />
  </section>
</BaseLayout>
