<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>코사인 팔레트 조절기</title>
    <meta name="description" content="iq의 코사인 팔레트 a + b·cos(2π(c·t + d))를 슬라이더로 조절하고 GLSL 코드로 복사합니다." />
  </head>
  <body>
    <main>
      <header>
        <h1>코사인 팔레트 조절기</h1>
        <p class="formula"><code>color(t) = a + b · cos(2π · (c · t + d))</code></p>
      </header>

      <section class="previews" aria-label="미리보기">
        <figure>
          <canvas id="strip" aria-label="t가 0에서 1까지 변할 때의 그라데이션"></canvas>
          <figcaption>그라데이션 (t = 0 → 1)</figcaption>
        </figure>
        <figure>
          <canvas id="curves" aria-label="R, G, B 채널 곡선"></canvas>
          <figcaption>채널 곡선 <span id="clip-note" class="warn" hidden>· 0~1 밖으로 나가는 구간이 있어요</span></figcaption>
        </figure>
        <figure class="radial-figure">
          <canvas id="radial" aria-label="중심으로부터의 거리를 t로 쓴 고리 미리보기"></canvas>
          <figcaption>고리 (t = 중심에서의 거리)</figcaption>
        </figure>
      </section>

      <section aria-label="효과 미리보기">
        <div class="fx-head">
          <h2>효과 미리보기 <span id="fx-name" class="fx-name"></span></h2>
          <div class="fx-controls">
            <button type="button" id="fx-prev" aria-label="이전 효과">←</button>
            <button type="button" id="fx-next" aria-label="다음 효과">→</button>
            <button type="button" id="fx-seed">새 시드</button>
            <label class="toggle"><input type="checkbox" id="fx-dark" checked /> 배경 어둡게 고정</label>
          </div>
        </div>
        <div id="fx-frame" class="fx-frame">
          <p id="fx-status" class="fx-status" role="status">효과를 불러오는 중이에요.</p>
        </div>
        <div class="fx-roles" aria-label="효과에 쓰인 색">
          <span><i id="role-bg"></i>배경 · 가장 어두운 색</span>
          <span><i id="role-ink"></i>글자 · 가장 밝은 색</span>
          <span><i id="role-accent"></i>강조 · 채도 높고 배경과 먼 색</span>
          <span id="fx-warn" class="warn" hidden>이 효과는 어두운 배경용이에요</span>
        </div>
        <div id="fx-list" class="fx-list" role="group" aria-label="효과 고르기"></div>
        <p class="hint">효과: <a href="https://github.com/Leonxlnx/taste-skill">taste-skill</a> by Leonxlnx (MIT). 팔레트를 64곳에서 샘플링해 배경·글자·강조색을 골라 넘겨요.</p>
      </section>

      <section aria-label="프리셋">
        <h2>프리셋</h2>
        <div id="presets" class="presets"></div>
      </section>

      <form id="params" aria-label="팔레트 값" onsubmit="return false"></form>

      <section aria-label="GLSL 코드">
        <div class="code-head">
          <h2>GLSL</h2>
          <button type="button" id="copy">복사</button>
        </div>
        <pre><code id="code"></code></pre>
        <p class="hint">주소창의 URL에 지금 값이 저장돼서, 그대로 공유하면 같은 팔레트가 열려요.</p>
      </section>
    </main>

    <script>
      type Vec3 = [number, number, number];
      type Key = 'a' | 'b' | 'c' | 'd';
      type Palette = Record<Key, Vec3>;

      const KEYS: Key[] = ['a', 'b', 'c', 'd'];
      const CHANNELS = ['R', 'G', 'B'] as const;
      const CHANNEL_COLORS = ['#ff6b6b', '#5fe08a', '#5fa8ff'];
      const INFO: Record<Key, { label: string; max: number }> = {
        a: { label: 'a · 기본 밝기', max: 1 },
        b: { label: 'b · 대비', max: 1 },
        c: { label: 'c · 반복 빈도', max: 3 },
        d: { label: 'd · 위상 (색 배치)', max: 1 }
      };

      const half: Vec3 = [0.5, 0.5, 0.5];
      const PRESETS: { name: string; p: Palette }[] = [
        { name: '무지개', p: { a: half, b: half, c: [1, 1, 1], d: [0, 0.33, 0.67] } },
        { name: '따뜻한 계열', p: { a: half, b: half, c: [1, 1, 1], d: [0, 0.1, 0.2] } },
        { name: '차가운 계열', p: { a: half, b: half, c: [1, 1, 1], d: [0.3, 0.2, 0.2] } },
        { name: '청록~노랑', p: { a: half, b: half, c: [1, 1, 0.5], d: [0.8, 0.9, 0.3] } },
        { name: '보라~주황', p: { a: half, b: half, c: [1, 0.7, 0.4], d: [0, 0.15, 0.2] } },
        { name: '네온', p: { a: half, b: half, c: [2, 1, 0], d: [0.5, 0.2, 0.25] } },
        { name: '파스텔', p: { a: [0.8, 0.5, 0.4], b: [0.2, 0.4, 0.2], c: [2, 1, 1], d: [0, 0.25, 0.25] } }
      ];

      const clone = (p: Palette): Palette => ({
        a: [...p.a] as Vec3, b: [...p.b] as Vec3, c: [...p.c] as Vec3, d: [...p.d] as Vec3
      });

      const fromHash = (): Palette | null => {
        const nums = location.hash.slice(1).split(',').map(Number);
        if (nums.length !== 12 || nums.some((n) => !Number.isFinite(n))) return null;
        const p = {} as Palette;
        KEYS.forEach((k, i) => { p[k] = nums.slice(i * 3, i * 3 + 3) as Vec3; });
        return p;
      };

      let pal: Palette = fromHash() ?? clone(PRESETS[0].p);

      const evalPal = (t: number): Vec3 =>
        [0, 1, 2].map((i) => pal.a[i] + pal.b[i] * Math.cos(6.28318 * (pal.c[i] * t + pal.d[i]))) as Vec3;
      const to255 = (v: number) => Math.round(Math.min(Math.max(v, 0), 1) * 255);

      // ---- 슬라이더 만들기
      const form = document.querySelector<HTMLFormElement>('#params')!;
      const inputs = {} as Record<Key, HTMLInputElement[]>;
      const outputs = {} as Record<Key, HTMLOutputElement[]>;
      for (const k of KEYS) {
        const fieldset = document.createElement('fieldset');
        const legend = document.createElement('legend');
        legend.textContent = INFO[k].label;
        fieldset.append(legend);
        inputs[k] = []; outputs[k] = [];
        CHANNELS.forEach((ch, i) => {
          const label = document.createElement('label');
          const name = document.createElement('span');
          name.textContent = ch;
          name.style.color = CHANNEL_COLORS[i];
          const output = document.createElement('output');
          const input = document.createElement('input');
          input.type = 'range'; input.min = '0'; input.max = String(INFO[k].max); input.step = '0.01';
          input.setAttribute('aria-label', `${k} ${ch}`);
          input.style.accentColor = CHANNEL_COLORS[i];
          input.addEventListener('input', () => { pal[k][i] = Number(input.value); update(false); });
          label.append(name, output, input);
          fieldset.append(label);
          inputs[k].push(input); outputs[k].push(output);
        });
        form.append(fieldset);
      }

      // ---- 프리셋 버튼
      const presetBox = document.querySelector<HTMLElement>('#presets')!;
      for (const preset of PRESETS) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = preset.name;
        const stops = [0, 0.25, 0.5, 0.75, 1].map((t) => {
          const c = preset.p;
          const rgb = [0, 1, 2].map((i) => to255(c.a[i] + c.b[i] * Math.cos(6.28318 * (c.c[i] * t + c.d[i]))));
          return `rgb(${rgb.join(',')})`;
        });
        button.style.setProperty('--swatch', `linear-gradient(90deg, ${stops.join(',')})`);
        button.addEventListener('click', () => { pal = clone(preset.p); update(true); });
        presetBox.append(button);
      }

      // ---- 캔버스
      const strip = document.querySelector<HTMLCanvasElement>('#strip')!;
      const curves = document.querySelector<HTMLCanvasElement>('#curves')!;
      const radial = document.querySelector<HTMLCanvasElement>('#radial')!;
      const clipNote = document.querySelector<HTMLElement>('#clip-note')!;
      const fit = (canvas: HTMLCanvasElement) => {
        const dpr = Math.min(devicePixelRatio, 2);
        const w = Math.max(1, Math.round(canvas.clientWidth * dpr));
        const h = Math.max(1, Math.round(canvas.clientHeight * dpr));
        if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }
        return canvas.getContext('2d')!;
      };

      const drawStrip = () => {
        const ctx = fit(strip);
        const { width: w, height: h } = strip;
        for (let x = 0; x < w; x++) {
          const [r, g, b] = evalPal(x / (w - 1));
          ctx.fillStyle = `rgb(${to255(r)},${to255(g)},${to255(b)})`;
          ctx.fillRect(x, 0, 1, h);
        }
      };

      const drawCurves = () => {
        const ctx = fit(curves);
        const { width: w, height: h } = curves;
        const pad = h * 0.15;
        const y = (v: number) => h - pad - v * (h - 2 * pad);
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = '#ffffff08';
        ctx.fillRect(0, y(1), w, y(0) - y(1));
        ctx.strokeStyle = '#294057'; ctx.lineWidth = 1;
        for (const v of [0, 1]) { ctx.beginPath(); ctx.moveTo(0, y(v)); ctx.lineTo(w, y(v)); ctx.stroke(); }
        ctx.lineWidth = Math.max(1.5, w / 400);
        let clipped = false;
        for (let i = 0; i < 3; i++) {
          ctx.strokeStyle = CHANNEL_COLORS[i];
          ctx.beginPath();
          for (let x = 0; x < w; x++) {
            const v = evalPal(x / (w - 1))[i];
            if (v < -0.001 || v > 1.001) clipped = true;
            const yy = Math.min(Math.max(y(v), 0), h);
            if (x === 0) ctx.moveTo(x, yy); else ctx.lineTo(x, yy);
          }
          ctx.stroke();
        }
        clipNote.hidden = !clipped;
      };

      const drawRadial = () => {
        const ctx = fit(radial);
        const { width: w, height: h } = radial;
        const img = ctx.createImageData(w, h);
        const cx = w / 2, cy = h / 2, rMax = Math.min(w, h) / 2;
        for (let py = 0; py < h; py++) {
          for (let px = 0; px < w; px++) {
            const t = Math.hypot(px - cx, py - cy) / rMax;
            const o = (py * w + px) * 4;
            if (t > 1) { img.data[o + 3] = 0; continue; }
            const [r, g, b] = evalPal(t);
            img.data[o] = to255(r); img.data[o + 1] = to255(g); img.data[o + 2] = to255(b); img.data[o + 3] = 255;
          }
        }
        ctx.putImageData(img, 0, 0);
      };

      // ---- 코드 출력
      const codeEl = document.querySelector<HTMLElement>('#code')!;
      const fmt = (v: Vec3) => `vec3(${v.map((n) => n.toFixed(2)).join(', ')})`;
      const makeCode = () =>
        `vec3 palette(float t) {\n` +
        `    vec3 a = ${fmt(pal.a)};\n` +
        `    vec3 b = ${fmt(pal.b)};\n` +
        `    vec3 c = ${fmt(pal.c)};\n` +
        `    vec3 d = ${fmt(pal.d)};\n` +
        `    return a + b * cos(6.28318 * (c * t + d));\n` +
        `}`;

      const copyBtn = document.querySelector<HTMLButtonElement>('#copy')!;
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(makeCode());
          copyBtn.textContent = '복사됨';
        } catch {
          copyBtn.textContent = '복사 실패';
        }
        setTimeout(() => { copyBtn.textContent = '복사'; }, 1200);
      });

      // ---- taste-skill 효과 미리보기
      type FxPalette = { bg: string; ink: string; accent: string };
      type FxApi = { setPalette(p: FxPalette): FxApi | Promise<FxApi>; destroy(): void };
      type FxLib = {
        mount(el: HTMLElement, id: string, o: { palette: FxPalette; seed: number }): Promise<FxApi>;
        paletteKind(p: FxPalette): string;
      };
      const FX_BASE = '/lib/taste-fx/';
      const EFFECTS: [string, string, string][] = [
        ['film-light-leak', 'Film light leak', 'Grain'], ['grain-gradient', 'Grain gradient', 'Grain'],
        ['ascii-shade', 'ASCII shade', 'Dither'], ['bayer-dither', 'Bayer dither', 'Dither'],
        ['halftone-screen', 'Halftone screen', 'Dither'], ['line-engraving', 'Line engraving', 'Dither'],
        ['aurora-curtains', 'Aurora curtains', 'Mesh'], ['gradient-mesh', 'Gradient mesh', 'Mesh'],
        ['painterly-landscape', 'Painterly landscape', 'Mesh'], ['edge-glow', 'Edge glow', 'Light'],
        ['god-rays', 'God rays', 'Light'], ['orb-sphere', 'Light orb', 'Light'],
        ['prism-dispersion', 'Prism light', 'Light'], ['soft-light-bars', 'Soft light bars', 'Light'],
        ['spotlight-cone', 'Stage spotlight', 'Light'], ['caustics', 'Water caustics', 'Light'],
        ['dot-terrain', 'Dot terrain', 'Pattern'], ['dotted-globe', 'Dotted globe', 'Pattern'],
        ['grid-pulse', 'Grid pulse', 'Pattern'], ['ridgeline', 'Ridgeline', 'Pattern'],
        ['ruled-grounds', 'Ruled dot ground', 'Pattern'], ['contour-lines', 'Topographic contours', 'Pattern'],
        ['fluted-glass', 'Fluted glass', 'Material'], ['silk-folds', 'Silk folds', 'Material'],
        ['duotone-grade', 'Duotone grade', 'Photo']
      ];
      const DARK_ONLY = new Set(['aurora-curtains', 'film-light-leak', 'god-rays', 'prism-dispersion', 'spotlight-cone']);

      const fxFrame = document.querySelector<HTMLElement>('#fx-frame')!;
      const fxStatus = document.querySelector<HTMLElement>('#fx-status')!;
      const fxName = document.querySelector<HTMLElement>('#fx-name')!;
      const fxWarn = document.querySelector<HTMLElement>('#fx-warn')!;
      const fxDark = document.querySelector<HTMLInputElement>('#fx-dark')!;
      const fxList = document.querySelector<HTMLElement>('#fx-list')!;
      const roleEls = {
        bg: document.querySelector<HTMLElement>('#role-bg')!,
        ink: document.querySelector<HTMLElement>('#role-ink')!,
        accent: document.querySelector<HTMLElement>('#role-accent')!
      };

      const hex = (v: Vec3) => '#' + v.map((n) => to255(n).toString(16).padStart(2, '0')).join('');
      const luma = (v: Vec3) => 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2];
      const fxPalette = (): FxPalette => {
        const samples = Array.from({ length: 64 }, (_, i) =>
          evalPal(i / 63).map((n) => Math.min(Math.max(n, 0), 1)) as Vec3);
        const by = (score: (v: Vec3) => number) => samples.reduce((a, b) => (score(b) > score(a) ? b : a));
        const dark = by((v) => -luma(v));
        const bgV: Vec3 = fxDark.checked ? [11 / 255, 17 / 255, 26 / 255] : dark;
        const far = (v: Vec3) => Math.hypot(v[0] - bgV[0], v[1] - bgV[1], v[2] - bgV[2]);
        // 강조색: 채도가 높으면서 배경과 멀리 떨어진 색
        const accent = by((v) => (Math.max(...v) - Math.min(...v) + 0.05) * far(v));
        return { bg: hex(bgV), ink: hex(by(luma)), accent: hex(accent) };
      };

      let fxLib: FxLib | null = null;
      let fxApi: FxApi | null = null;
      let fxIndex = Math.max(0, EFFECTS.findIndex(([id]) => id === 'orb-sphere'));
      let fxSeed = 21;
      let fxToken = 0;
      let fxPending = false;
      let fxLastKey = '';

      const fxButtons = EFFECTS.map(([, name, family], i) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.innerHTML = `${name}<small>${family}</small>`;
        button.addEventListener('click', () => mountFx(i));
        fxList.append(button);
        return button;
      });

      const showRoles = (p: FxPalette) => {
        for (const k of ['bg', 'ink', 'accent'] as const) roleEls[k].style.background = p[k];
        fxWarn.hidden = !(fxLib && DARK_ONLY.has(EFFECTS[fxIndex][0]) && fxLib.paletteKind(p) === 'light');
      };

      async function mountFx(i: number) {
        fxIndex = (i + EFFECTS.length) % EFFECTS.length;
        const [id, name] = EFFECTS[fxIndex];
        fxName.textContent = name;
        fxButtons.forEach((b, k) => b.setAttribute('aria-pressed', String(k === fxIndex)));
        const token = ++fxToken;
        try {
          fxLib ??= ((await import(/* @vite-ignore */ FX_BASE + 'fx.js')).default as FxLib);
          const p = fxPalette();
          fxApi?.destroy();
          fxApi = null;
          const api = await fxLib.mount(fxFrame, id, { palette: p, seed: fxSeed });
          if (token !== fxToken) { api.destroy(); return; }
          fxApi = api;
          fxLastKey = JSON.stringify(p);
          fxStatus.hidden = true;
          showRoles(p);
        } catch {
          fxStatus.textContent = '효과를 불러오지 못했어요.';
          fxStatus.hidden = false;
        }
      }

      // 슬라이더를 끄는 동안에는 너무 자주 다시 그리지 않도록 120ms에 한 번만 색을 넘겨요.
      const syncFx = () => {
        if (fxPending || !fxApi) return;
        fxPending = true;
        setTimeout(async () => {
          fxPending = false;
          const p = fxPalette();
          const key = JSON.stringify(p);
          if (!fxApi || key === fxLastKey) return;
          fxLastKey = key;
          showRoles(p);
          const token = fxToken;
          const next = await fxApi.setPalette(p);
          if (token === fxToken) fxApi = next;
        }, 120);
      };

      document.querySelector('#fx-prev')!.addEventListener('click', () => mountFx(fxIndex - 1));
      document.querySelector('#fx-next')!.addEventListener('click', () => mountFx(fxIndex + 1));
      document.querySelector('#fx-seed')!.addEventListener('click', () => {
        fxSeed = Math.floor(Math.random() * 10000);
        mountFx(fxIndex);
      });
      fxDark.addEventListener('change', syncFx);

      let frame = 0;
      const draw = () => { frame = 0; drawStrip(); drawCurves(); drawRadial(); };
      const update = (syncInputs: boolean) => {
        for (const k of KEYS) {
          for (let i = 0; i < 3; i++) {
            if (syncInputs) inputs[k][i].value = String(pal[k][i]);
            outputs[k][i].value = pal[k][i].toFixed(2);
          }
        }
        codeEl.textContent = makeCode();
        syncFx();
        history.replaceState(null, '', '#' + KEYS.flatMap((k) => pal[k].map((n) => +n.toFixed(2))).join(','));
        if (!frame) frame = requestAnimationFrame(draw);
      };

      new ResizeObserver(() => { if (!frame) frame = requestAnimationFrame(draw); }).observe(document.body);
      update(true);
      mountFx(fxIndex);
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  body { margin: 0; font: 14px/1.5 system-ui, sans-serif; color: #e5f3ff; background: #0d1b2b; }
  main { max-width: 960px; margin: 0 auto; padding: 20px 16px 40px; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  h2 { font-size: 14px; margin: 0; color: #9fb7cc; font-weight: 600; }
  .formula { margin: 0 0 18px; color: #9fb7cc; }
  code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .formula code { color: #72d9ff; }

  .previews { display: grid; grid-template-columns: 1fr 200px; grid-template-rows: auto auto; gap: 12px; }
  figure { margin: 0; }
  figcaption { font-size: 12px; color: #7f97ad; margin-top: 4px; }
  .previews canvas { display: block; width: 100%; border: 1px solid #294057; border-radius: 8px; background: #0a1522; }
  #strip { height: 72px; }
  #curves { height: 140px; }
  .radial-figure { grid-column: 2; grid-row: 1 / span 2; }
  .previews #radial { aspect-ratio: 1; height: auto; border-radius: 50%; border: 0; background: none; }
  .warn { color: #ffb36b; }

  section { margin-top: 22px; }
  a { color: #72d9ff; }

  .fx-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
  .fx-name { color: #e5f3ff; font-weight: 600; margin-left: 6px; }
  .fx-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .toggle { display: inline-flex; align-items: center; gap: 6px; margin: 0; font-size: 12px; color: #9fb7cc; cursor: pointer; }
  .toggle input { margin: 0; accent-color: #72d9ff; }
  .fx-frame { position: relative; isolation: isolate; overflow: hidden; margin-top: 10px; aspect-ratio: 16 / 9; max-height: 480px; width: 100%; border: 1px solid #294057; border-radius: 10px; background: #0a1522; }
  .fx-status { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; color: #7f97ad; font-size: 13px; }
  .fx-roles { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 8px; font-size: 12px; color: #7f97ad; }
  .fx-roles span { display: inline-flex; align-items: center; gap: 6px; }
  .fx-roles i { display: inline-block; width: 14px; height: 14px; border-radius: 4px; border: 1px solid #ffffff33; }
  .fx-list { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .fx-list button { font-size: 12px; padding: 4px 10px; }
