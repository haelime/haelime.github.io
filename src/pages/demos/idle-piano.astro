---
const notes = ['도', '레', '미', '파', '솔', '라', '시'];
const rows = [
  { label: '내 피아노', detail: '입력 직후', color: '#93d6ff' },
  { label: '도착 즉시 반영', detail: '비교용', color: '#f5ba82' },
  { label: '버퍼를 거쳐 반영', detail: 'Idle Together의 방식', color: '#9be1b8' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>피아노로 보는 연주 프로토콜</title>
  </head>
  <body>
    <main>
      <header><span class="eyebrow">입력 → Host 중계 → 상대의 재생</span><h1>같은 음을 두 번 누르면</h1><p>건반과 시간표로 비교하는 전송 원리. 소리 없이 4배 느리게 표시합니다.</p></header>
      <div class="settings">
        <label>회선 상태<select id="network"><option value="stable">일정한 지연</option><option value="jitter" selected>들쭉날쭉한 도착</option><option value="late">중간 패킷 재전송</option></select></label>
        <label>상대의 재생 버퍼 <output id="delay-value">80ms</output><input id="delay" type="range" min="20" max="200" step="10" value="80" /></label>
      </div>
      <div class="notes" role="group" aria-label="예시에 사용할 음 선택">
        {notes.map((note, index) => <button class="note" data-note={index} aria-pressed={index === 0 ? 'true' : 'false'}>{note}</button>)}
        <button class="note" data-note="chord" aria-pressed="false">도미솔</button>
      </div>
      <div id="stage">
        <div id="view" aria-hidden="true"></div>
        <div class="rows">
          {rows.map(row => <section class="row" style={`--accent:${row.color}`}><div class="row-title"><strong>{row.label}</strong><small>{row.detail}</small><output class="state">놓음</output></div><div class="timeline" aria-label={`${row.label}의 키를 누른 구간`}><div class="cursor"></div></div></section>)}
        </div>
      </div>
      <p id="webgl-status" role="status" hidden>3D 건반을 표시할 수 없어 아래 시간표로 보여 줍니다.</p>
      <div class="controls"><button id="play">재생</button><button id="step">40ms씩 보기</button><button id="reset">처음으로</button><output id="clock">0ms</output></div>
      <p id="packet">아직 보낸 입력이 없습니다.</p>
      <p id="explanation" role="status"></p>
      <footer>밝은 막대는 건반을 누른 구간입니다. 시간은 설명용 설정이며 실측값이 아닙니다. 공통 시계가 일치한다고 가정하고, 주기적인 상태 전송과 프레임 지연은 생략했습니다.</footer>
    </main>
    <script>
      import * as THREE from 'three';
      import { pianoExample, maskAt } from '../../lib/idle-piano.mjs';

      const get = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const network = get<HTMLSelectElement>('network');
      const delay = get<HTMLInputElement>('delay');
      const play = get<HTMLButtonElement>('play');
      const view = get<HTMLDivElement>('view');
      const timelines = [...document.querySelectorAll<HTMLElement>('.timeline')];
      const states = [...document.querySelectorAll<HTMLOutputElement>('.state')];
      const names = ['도', '레', '미', '파', '솔', '라', '시'];
      const colors = [0x93d6ff, 0xf5ba82, 0x9be1b8];
      let note = 0;
      let chord = false;
      let example = pianoExample();
      let time = -1;
      let running = false;
      let frame = 0;
      let previous = 0;
      let renderer: THREE.WebGLRenderer | undefined;
      const scene = new THREE.Scene();
      const camera = new THREE.OrthographicCamera(-4.3, 4.3, 6, -6, 0.1, 100);
      camera.position.set(0, 0, 20);
      const keys: THREE.Mesh<THREE.BoxGeometry, THREE.MeshStandardMaterial>[][] = [];
      try {
        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
        view.append(renderer.domElement);
        scene.add(new THREE.HemisphereLight(0xffffff, 0x304050, 2.5));
        const light = new THREE.DirectionalLight(0xffffff, 3);
        light.position.set(-3, 6, 10);
        scene.add(light);
        const white = new THREE.BoxGeometry(0.91, 2.1, 0.35);
        const black = new THREE.BoxGeometry(0.55, 1.25, 0.45);
        for (let row = 0; row < 3; row++) {
          const group = new THREE.Group();
          group.position.y = 3.9 - row * 4;
          group.rotation.x = -0.28;
          const rowKeys = [];
          for (let key = 0; key < 7; key++) {
            const mesh = new THREE.Mesh(white, new THREE.MeshStandardMaterial({ color: 0xe9edf3, roughness: 0.4 }));
            mesh.position.x = key - 3;
            group.add(mesh); rowKeys.push(mesh);
          }
          for (const key of [0, 1, 3, 4, 5]) {
            const mesh = new THREE.Mesh(black, new THREE.MeshStandardMaterial({ color: 0x18222b }));
            mesh.position.set(key - 2.5, 0.43, 0.36);
            group.add(mesh);
          }
          scene.add(group); keys.push(rowKeys);
        }
        new ResizeObserver(() => { renderer!.setSize(view.clientWidth, view.clientHeight); draw(); }).observe(view);
        renderer.domElement.addEventListener('webglcontextlost', event => {
          event.preventDefault(); pause(); renderer = undefined;
          get('webgl-status').hidden = false;
        });
      } catch {
        renderer = undefined;
        get('webgl-status').hidden = false;
      }

      function draw() {
        const tracks = [example.inputs, example.arrivals, example.buffered];
        tracks.forEach((events, row) => {
          const mask = maskAt(events, time);
          states[row].value = names.filter((_, key) => mask & (1 << key)).join(' + ') || '놓음';
          keys[row]?.forEach((key, index) => {
            const pressed = Boolean(mask & (1 << index));
            key.material.color.setHex(pressed ? colors[row] : 0xe9edf3);
            key.position.z = pressed ? -0.12 : 0;
          });
          timelines[row].querySelector<HTMLElement>('.cursor')!.style.left = `${Math.max(0, time) / example.duration * 100}%`;
        });
        renderer?.render(scene, camera);
        get<HTMLOutputElement>('clock').value = `${Math.max(0, Math.round(time))}ms`;
        const sent = example.inputs.filter(event => event.time <= time);
        const received = example.arrivals.filter(event => event.time <= time).length;
        const played = example.buffered.filter(event => event.time <= time).length;
        const last = sent.at(-1);
        get('packet').textContent = last
          ? `보낸 입력 #${last.sequence} / ${last.time}ms / ${last.mask ? '누름' : '놓음'}  →  이동 중 ${sent.length - received}개 / 재생 대기 ${received - played}개`
          : '아직 보낸 입력이 없습니다.';
      }
      function pause() {
        running = false; cancelAnimationFrame(frame); play.textContent = '재생';
      }
      function animate(now: number) {
        if (!running) return;
        time = Math.min(example.duration, Math.max(0, time) + Math.min(now - previous, 100) / 4);
        previous = now; draw();
        if (time >= example.duration) pause();
        else frame = requestAnimationFrame(animate);
      }
      function reset() {
        pause(); time = -1;
        example = pianoExample({ note, chord, network: network.value, delay: Number(delay.value) });
        get<HTMLOutputElement>('delay-value').value = `${delay.value}ms`;
        [example.inputs, example.arrivals, example.buffered].forEach((events, row) => {
          timelines[row].querySelectorAll('.bar').forEach(bar => bar.remove());
          events.forEach((event, index) => {
            if (!event.mask) return;
            const end = events[index + 1]?.time ?? example.duration;
            const bar = document.createElement('span');
            bar.className = 'bar';
            bar.style.left = `${event.time / example.duration * 100}%`;
            bar.style.width = `${(end - event.time) / example.duration * 100}%`;
            bar.title = `${event.time}~${end}ms 동안 누름`;
            timelines[row].append(bar);
          });
        });
        get('explanation').textContent = network.value === 'late'
          ? '가운데 입력이 늦어지면 뒤의 입력도 함께 기다립니다. 도착 즉시 반영하면 놓고 다시 누르는 순간이 합쳐집니다. 버퍼에서는 그 사이를 벌리는 만큼 연주가 더 늦어집니다.'
          : network.value === 'stable'
            ? '도착 간격이 일정하면 바로 반영해도 리듬이 유지됩니다. 버퍼를 늘리면 그만큼 상대의 재생이 늦어집니다.'
            : '내 입력은 120ms 간격입니다. 버퍼가 도착 지연을 감당하는 범위에서는 상대도 같은 간격으로 반영합니다. 버퍼를 줄여 차이를 비교해 보세요.';
        draw();
      }
      play.addEventListener('click', () => {
        if (running) { pause(); return; }
        if (time >= example.duration) time = -1;
        running = true; previous = performance.now(); play.textContent = '일시정지';
        frame = requestAnimationFrame(animate);
      });
      get('step').addEventListener('click', () => { pause(); time = Math.min(example.duration, time < 0 ? 0 : time + 40); draw(); });
      get('reset').addEventListener('click', reset);
      network.addEventListener('change', reset);
      delay.addEventListener('input', reset);
      document.querySelectorAll<HTMLButtonElement>('.note').forEach(button => {
        button.addEventListener('click', () => {
          chord = button.dataset.note === 'chord';
          if (!chord) note = Number(button.dataset.note);
          document.querySelectorAll('.note').forEach(other => other.setAttribute('aria-pressed', String(other === button)));
          reset();
        });
      });
      document.addEventListener('visibilitychange', () => { if (document.hidden) pause(); });
      new IntersectionObserver(([entry]) => { if (!entry.isIntersecting) pause(); }).observe(view);
      reset();
    </script>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #101d28; color: #ebf0f5; font: 14px/1.5 system-ui, sans-serif; }
  main { max-width: 960px; margin: auto; padding: 20px; }
  .eyebrow { font-size: 11px; color: #9be1b8; letter-spacing: .04em; }
  h1 { font-size: 22px; margin: 4px 0; }
  p { margin: 6px 0; color: #becbd5; }
  .settings { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 14px 0; }
  label { font-size: 12px; }
  select { display: block; width: 100%; margin-top: 5px; padding: 7px; }
  input { display: block; width: 100%; margin: 12px 0; accent-color: #9be1b8; }
  output { font-variant-numeric: tabular-nums; }
  #delay-value { float: right; }
  button, select { border: 1px solid #4b6171; background: #1e3040; color: #ebf0f5; border-radius: 6px; font: inherit; }
  button { cursor: pointer; padding: 8px 12px; min-height: 40px; }
  button:hover { background: #314b5e; }
  :is(button, select, input):focus-visible { outline: 2px solid #93d6ff; outline-offset: 3px; }
  .notes { display: grid; grid-template-columns: repeat(7, 1fr) 1.5fr; gap: 5px; }
  .note { padding: 6px 0; }
  .note[aria-pressed="true"] { background: #93d6ff; color: #101d28; border-color: #93d6ff; }
  #stage { position: relative; height: 300px; margin-top: 12px; border-block: 1px solid #314555; }
  #view { position: absolute; left: 0; top: 0; width: 40%; height: 100%; }
  #view :global(canvas) { display: block; }
  .rows { position: absolute; inset: 0; display: grid; grid-template-rows: repeat(3, 1fr); pointer-events: none; }
  .row { padding: 10px 0 10px 43%; border-bottom: 1px solid #253744; }
  .row:last-child { border: 0; }
  .row-title { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; line-height: 1.3; }
  strong { font-size: 13px; color: var(--accent); }
  small { color: #aebdca; font-size: 10px; }
  .state { width: 100%; font-size: 12px; }
  .timeline { position: relative; height: 14px; background: #233644; margin: 9px 5px 0 0; }
  .timeline :global(.bar) { position: absolute; height: 100%; background: var(--accent); opacity: .8; }
  .cursor { position: absolute; z-index: 1; width: 2px; top: -3px; bottom: -3px; background: white; }
  .controls { display: flex; gap: 8px; align-items: center; margin: 12px 0; }
  #play { background: #9be1b8; border-color: #9be1b8; color: #10261b; min-width: 90px; }
  #clock { margin-left: auto; font-size: 12px; }
  #packet { font-size: 11px; color: #93d6ff; min-height: 34px; }
  #explanation { font-size: 12px; min-height: 54px; }
  footer { font-size: 10px; color: #9badbc; margin-top: 8px; }
  @media (max-width: 480px) { main { padding: 12px; } h1 { font-size: 20px; } header p { font-size: 12px; } .settings { gap: 12px; } #view { width: 38%; } .row { padding-left: 40%; } .row-title { gap: 2px 6px; } small { width: 100%; } .controls { gap: 5px; } .controls button { font-size: 12px; white-space: nowrap; } #play { min-width: 64px; } button { padding-inline: 8px; } }
</style>
