---
const fields = [
  { name: 'Magic', start: 0, size: 4, color: '#91bfff', description: '49 54 4D 31은 ASCII ITM1입니다. 일반 Netcode 메시지와 악기 전용 메시지를 구분합니다.' },
  { name: 'Version', start: 4, size: 1, color: '#b4a3ed', description: '현재 형식은 v2입니다. Magic의 ITM1과 별도로 버전을 검사하며, 다른 버전은 거부합니다.' },
  { name: 'Flags', start: 5, size: 1, color: '#d9a0d5', description: 'bit 0은 연주 중 여부입니다. 나머지 비트는 예약되어 있으며, 알 수 없는 비트가 켜진 패킷은 거부합니다.' },
  { name: 'Sequence', start: 6, size: 2, color: '#f4bf81', description: 'ushort 순서 번호입니다. 65,535 다음은 0이며, 두 번호의 차이가 1~32,767일 때 새 입력으로 판단합니다.' },
  { name: 'NetworkObjectId', start: 8, size: 8, color: '#96d6ca', description: '연주하는 NetworkObject의 64비트 ID입니다. Host는 연결에서 확인한 송신자와 이 객체의 소유자가 같은지 검사합니다.' },
  { name: 'InstrumentIndex', start: 16, size: 1, color: '#b5d78f', description: '공통 카탈로그의 악기 번호입니다. 같은 번호가 같은 악기를 가리키도록 참가자들이 같은 카탈로그를 사용해야 합니다.' },
  { name: 'PressedMask', start: 17, size: 1, color: '#f0d886', description: '8개 입력 슬롯을 1바이트에 담습니다. 01은 0번 슬롯이 눌린 상태입니다. 음높이 해석은 악기 정의가 담당합니다.' },
  { name: 'ServerTime', start: 18, size: 8, color: '#94cce7', description: '입력 시점의 공통 시각을 IEEE 754 double로 기록합니다. Host가 중계할 때 도착 시각으로 바꾸지 않습니다.' },
];
---
<!doctype html>
<html lang="ko">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex" /><title>악기 프레임워크의 패킷 전달과 바이트 구조</title></head>
  <body>
    <main>
      <header><span class="eyebrow">01 / 전달 경로</span><h1>입력 하나가 상대에게 닿기까지</h1><p>내 입력은 즉시 반영하고, 같은 패킷을 Host가 검사해 참가자에게 전달합니다.</p></header>
      <div class="controls"><button id="send">입력 보내기</button><label>먼 PC 경로 지연 <output id="distance-value">90ms</output><input id="distance" type="range" min="10" max="180" step="10" value="90" /></label></div>
      <div id="stage">
        <div id="view" aria-hidden="true"></div>
        <div class="actor" id="local-label"><strong>내 PC</strong><span id="local-state">대기</span></div>
        <div class="actor" id="host-label"><strong>Host</strong><span id="host-state">검사 대기</span></div>
        <div class="actor" id="near-label"><strong>가까운 PC</strong><span id="near-state">대기</span></div>
        <div class="actor" id="far-label"><strong>먼 PC</strong><span id="far-state">대기</span></div>
      </div>
      <p id="webgl-status" hidden>3D 표시를 사용할 수 없습니다. 아래 시각과 상태로 전달 과정을 확인할 수 있습니다.</p>
      <div class="timing"><span>내 PC → Host <b>10ms</b></span><span>Host → 가까운 참가자 <b>10ms</b></span><span>상대의 재생 기준 <b>입력 + 80ms</b></span></div>
      <p id="progress" role="status">버튼을 누르면 0번 입력 슬롯의 패킷 하나를 보냅니다.</p>
      <p class="caption">거리는 회선 경로의 지연을 나타내는 모형이며, 게임 속 캐릭터 간 거리나 실제 측정값이 아닙니다. 화면은 12배 느리게 표시합니다. 인터넷으로 전송하지 않으며, 재전송과 50ms 주기 상태 전송, 시계 오차는 생략했습니다.</p>

      <section class="wire">
        <span class="eyebrow">02 / 패킷 내부</span><h2>직접 직렬화한 26바이트</h2><p>위 입력을 실제 C# 패킷 형식과 같은 바이트로 변환합니다. 숫자는 little-endian입니다.</p>
        <div class="wire-controls"><label for="field">필드 살펴보기</label><select id="field">{fields.map((field, index) => <option value={index} selected={index === 3}>{field.name}</option>)}</select><output id="sequence">예시 #65534</output></div>
        <div id="bytes" aria-label="오프셋과 16진수로 표시한 패킷 본문">
          {Array.from({ length: 26 }, (_, index) => {
            const field = fields.find(field => index >= field.start && index < field.start + field.size)!;
            return <div class="byte" style={`--color:${field.color}`}><small>{index.toString().padStart(2, '0')}</small><code>00</code></div>;
          })}
        </div>
        <div id="field-detail" aria-live="polite"><strong id="field-title"></strong><code id="field-value"></code><p id="field-description"></p></div>
        <p class="caption">위쪽 숫자는 바이트 오프셋, 아래쪽은 hex 값입니다. 각 전송에서 Sequence와 ServerTime이 바뀝니다. 예시 객체 ID는 42, 악기 번호는 0이며 Steam/IP/RPC 헤더는 이 26바이트에 포함되지 않습니다.</p>
      </section>
    </main>
    <script is:inline type="application/json" id="field-data" set:html={JSON.stringify(fields)}></script>
    <script>
      import * as THREE from 'three';
      import { encodePacket, decodePacket, delivery } from '../../lib/idle-protocol.mjs';
      const get = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const fieldInfo: { name: string; start: number; size: number; color: string; description: string }[] = JSON.parse(get('field-data').textContent!);
      const send = get<HTMLButtonElement>('send');
      const distance = get<HTMLInputElement>('distance');
      const fieldSelect = get<HTMLSelectElement>('field');
      const view = get('view');
      const bytes = [...document.querySelectorAll<HTMLElement>('.byte')];
      let sequence = 65534;
      let stamp = 1000;
      let wire = encodePacket({ sequence, serverTime: stamp });
      let timing = delivery(Number(distance.value));
      let time = -1;
      let previous = 0;
      let frame = 0;
      let running = false;
      let hostValid = false;
      const scene = new THREE.Scene();
      const camera = new THREE.OrthographicCamera(0, 100, 55, 0, 0.1, 100);
      camera.position.z = 20;
      let renderer: THREE.WebGLRenderer | undefined;
      const points = [new THREE.Vector3(12, 28, 0), new THREE.Vector3(37, 28, 0), new THREE.Vector3(64, 44, 0), new THREE.Vector3(88, 12, 0)];
      const nodes: THREE.Mesh<THREE.SphereGeometry, THREE.MeshStandardMaterial>[] = [];
      const markers: THREE.Mesh<THREE.SphereGeometry, THREE.MeshBasicMaterial>[] = [];
      const paths: THREE.Line[] = [];
      try {
        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
        view.append(renderer.domElement);
        scene.add(new THREE.HemisphereLight(0xffffff, 0x25445c, 2.5));
        const light = new THREE.DirectionalLight(0xffffff, 3); light.position.set(0, 50, 20); scene.add(light);
        for (const point of points) {
          const node = new THREE.Mesh(new THREE.SphereGeometry(2.3, 20, 12), new THREE.MeshStandardMaterial({ color: 0x587386, roughness: .4 }));
          node.position.copy(point); nodes.push(node); scene.add(node);
        }
        for (const [from, to] of [[0, 1], [1, 2], [1, 3]]) {
          const path = new THREE.Line(new THREE.BufferGeometry().setFromPoints([points[from], points[to]]), new THREE.LineBasicMaterial({ color: 0x446174 }));
          paths.push(path); scene.add(path);
          const marker = new THREE.Mesh(new THREE.SphereGeometry(.9, 12, 8), new THREE.MeshBasicMaterial({ color: 0xffcf8a }));
          markers.push(marker); scene.add(marker);
        }
        new ResizeObserver(() => {
          renderer?.setSize(view.clientWidth, view.clientHeight);
          const scaleY = view.clientWidth * 55 / (100 * view.clientHeight);
          [...nodes, ...markers].forEach(mesh => { mesh.scale.y = scaleY; });
          draw();
        }).observe(view);
        renderer.domElement.addEventListener('webglcontextlost', event => { event.preventDefault(); renderer = undefined; get('webgl-status').hidden = false; });
      } catch { renderer = undefined; get('webgl-status').hidden = false; }

      function inspect() {
        bytes.forEach((element, index) => { element.querySelector('code')!.textContent = wire[index].toString(16).padStart(2, '0').toUpperCase(); });
        const field = fieldInfo[Number(fieldSelect.value)];
        bytes.forEach((element, index) => element.classList.toggle('selected', index >= field.start && index < field.start + field.size));
        const packet = decodePacket(wire)!;
        const values = ['ITM1', '2', '00000001 / 연주 중', String(packet.sequence), packet.objectId.toString(), String(packet.instrument), '00000001 / 슬롯 0', `${packet.serverTime.toFixed(3)}초`];
        get('field-title').textContent = `${field.name} / offset ${field.start} / ${field.size} byte`;
        get('field-value').textContent = values[Number(fieldSelect.value)];
        get('field-description').textContent = field.description;
        get<HTMLOutputElement>('sequence').value = `${time < 0 ? '예시' : '전송'} #${sequence}`;
      }
      function draw() {
        if (time >= timing.host && !hostValid) hostValid = decodePacket(wire) !== null;
        const statuses = [time >= 0, hostValid, time >= timing.nearPlay, time >= timing.farPlay];
        nodes.forEach((node, index) => { node.position.copy(points[index]); node.material.color.setHex(statuses[index] ? 0x98dfbf : 0x587386); });
        const journeys = [[0, timing.host, 0, 1], [timing.host, timing.near, 1, 2], [timing.host, timing.far, 1, 3]];
        journeys.forEach(([start, end, from, to], index) => {
          if (!markers[index]) return;
          markers[index].visible = time >= start && time < end;
          markers[index].position.lerpVectors(points[from], points[to], Math.max(0, Math.min(1, (time - start) / (end - start))));
        });
        ['local', 'host', 'near', 'far'].forEach((name, index) => {
          const label = get(`${name}-label`); label.style.left = `${points[index].x}%`; label.style.top = `${(55 - points[index].y) / 55 * 100 + 7}%`;
        });
        get('local-state').textContent = time >= 0 ? '즉시 반영' : '대기';
        get('host-state').textContent = hostValid ? '검사 후 중계' : '검사 대기';
        get('near-state').textContent = time >= timing.nearPlay ? '80ms 반영' : time >= timing.near ? '수신 / 버퍼 대기' : '대기';
        get('far-state').textContent = time >= timing.farPlay ? `${timing.farPlay}ms 반영` : time >= timing.far ? '수신 / 버퍼 대기' : '대기';
        if (time >= timing.farPlay) get('progress').textContent = `가까운 참가자: ${timing.near}ms 수신 → ${timing.nearPlay}ms 반영. 먼 참가자: ${timing.far}ms 수신 → ${timing.farPlay}ms 반영. ${timing.far > 80 ? '80ms 이후에 도착한 입력은 그만큼 늦게 반영됩니다.' : '두 경로 모두 80ms 안에 도착해 같은 목표 시각에 반영됩니다.'}`;
        else if (time >= 0) get('progress').textContent = `${Math.round(time)}ms / 로컬 반영 → 26바이트 직렬화 → Host 검사 → 참가자별 수신과 재생 대기`;
        renderer?.render(scene, camera);
      }
      function animate(now: number) {
        if (!running) return;
        time = Math.min(timing.farPlay + 80, time + Math.min(now - previous, 100) / 12);
        previous = now; draw();
        if (time >= timing.farPlay + 80) { running = false; send.disabled = false; distance.disabled = false; }
        else frame = requestAnimationFrame(animate);
      }
      function reset() {
        running = false; cancelAnimationFrame(frame); time = -1; hostValid = false;
        timing = delivery(Number(distance.value));
        points[3].x = 70 + Number(distance.value) / 10;
        paths[2]?.geometry.setFromPoints([points[1], points[3]]);
        get<HTMLOutputElement>('distance-value').value = `${distance.value}ms`;
        send.disabled = false; distance.disabled = false;
        get('progress').textContent = '버튼을 누르면 0번 입력 슬롯의 패킷 하나를 보냅니다.';
        inspect(); draw();
      }
      send.addEventListener('click', () => {
        sequence = (sequence + 1) & 0xffff; stamp += .125;
        wire = encodePacket({ sequence, serverTime: stamp });
        time = 0; hostValid = false; running = true; previous = performance.now();
        send.disabled = true; distance.disabled = true;
        inspect(); draw(); frame = requestAnimationFrame(animate);
      });
      distance.addEventListener('input', reset);
      fieldSelect.addEventListener('change', inspect);
      document.addEventListener('visibilitychange', () => { if (document.hidden && running) reset(); });
      new IntersectionObserver(([entry]) => { if (!entry.isIntersecting && running) reset(); }).observe(view);
      const main = document.querySelector('main')!;
      new ResizeObserver(() => {
        const frameElement = window.frameElement as HTMLElement | null;
        if (frameElement) frameElement.style.height = `${main.offsetHeight + 2}px`;
      }).observe(main);
      reset();
    </script>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #101d28; color: #ecf2f7; font: 13px/1.5 system-ui, sans-serif; }
  main { max-width: 960px; padding: 20px; margin: auto; }
  h1, h2 { font-size: 21px; margin: 4px 0 8px; }
  p { margin: 6px 0; color: #bdccd6; }
  .eyebrow { font-size: 11px; color: #99dfbe; letter-spacing: .08em; }
  button, select { font: inherit; color: inherit; border: 1px solid #506778; border-radius: 6px; background: #213848; min-height: 40px; padding: 7px 10px; }
  button { cursor: pointer; background: #99dfbe; color: #122d21; border-color: #99dfbe; font-weight: 600; }
  button:disabled { opacity: .5; cursor: default; }
  :is(button, select, input):focus-visible { outline: 2px solid #9ecfff; outline-offset: 3px; }
  .controls { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 20px; align-items: center; margin-top: 16px; }
  label { font-size: 12px; }
  input { display: block; width: 100%; accent-color: #99dfbe; margin: 8px 0; }
  #distance-value { float: right; }
  #stage { position: relative; height: 225px; margin: 12px 0; }
  #view { position: absolute; inset: 0; }
  #view :global(canvas) { display: block; }
  .actor { position: absolute; transform: translateX(-50%); width: 23%; text-align: center; pointer-events: none; font-size: 12px; }
  .actor span { display: block; color: #99dfbe; font-size: 10px; }
  .timing { display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 11px; color: #c1d1dc; border-block: 1px solid #314958; padding: 9px 0; }
  .timing b { color: #99dfbe; white-space: nowrap; }
  #progress { min-height: 44px; margin: 12px 0 6px; }
  .caption { font-size: 11px; color: #9eb1bf; }
  .wire { margin-top: 24px; padding-top: 20px; border-top: 1px solid #435966; }
  .wire-controls { display: flex; align-items: center; gap: 10px; margin: 14px 0; flex-wrap: wrap; }
  .wire-controls label { display: none; }
  #sequence { margin-left: auto; font-size: 12px; color: #f4bf81; }
  #bytes { display: grid; grid-template-columns: repeat(13, minmax(0, 1fr)); gap: 4px; }
  .byte { background: #1d303e; text-align: center; border-bottom: 3px solid var(--color); border-radius: 3px; padding: 4px 0; }
  .byte small { display: block; font: 9px/1.5 monospace; color: #9fb2c0; }
  .byte code { color: var(--color); font-size: 13px; }
  .byte.selected { outline: 1px solid var(--color); background: #344958; }
  #field-detail { margin: 14px 0 8px; min-height: 94px; }
  #field-title { display: block; font-size: 12px; }
  #field-value { display: block; color: #f4bf81; margin: 4px 0; overflow-wrap: anywhere; }
  #field-description { font-size: 12px; }
  @media (max-width: 480px) { main { padding: 12px; } h1, h2 { font-size: 18px; } .controls { grid-template-columns: 100px minmax(0, 1fr); gap: 12px; } .controls label { font-size: 10px; } #stage { height: 190px; } .actor { font-size: 10px; } .actor span { font-size: 9px; } #bytes { grid-template-columns: repeat(8, minmax(0, 1fr)); } #field-detail { min-height: 122px; } }
</style>
