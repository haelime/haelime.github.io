---
import { getCollection } from 'astro:content';
import PortfolioAccordion from '../components/PortfolioAccordion.astro';
import { visibleProjects } from '../lib/portfolio';
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
const projects = visibleProjects(await getCollection('portfolio'), false);
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <section class="landing-document prose">
    <h1>프로필</h1>
    <div class="profile-intro">
      <img src="/assets/img/IMG_8923.jpg" alt="Hae Eem 프로필 사진" />
      <div>
        <h2>Hae Eem</h2>
        <p>C++ / C# 프로그래머입니다.</p>
        <div class="profile-links">
          <a href="https://github.com/haelime" target="_blank" rel="noreferrer">GitHub</a>
          <a href="mailto:loreminder@gmail.com">이메일</a>
        </div>
      </div>
    </div>
  </section>

  <section class="landing-document prose">
    <h2>경력</h2>
    <h3>웨어러블에이아이</h3>
    <p><strong>시스템 소프트웨어 엔지니어 / 주임연구원</strong> (2024.11–2025.04)</p>
    <p>인천국제공항 자율주행 셔틀 프로젝트에서 UDP 기반 LiDAR 데이터 처리, C++ / ROS2 기반 FSM 제어 로직, watchdog fail-safe 시스템을 개발했습니다.</p>
    <a class="project-card career-project-card" href="/posts/autonomous-shuttle-systems/">
      <span class="project-card__thumbnail">
        <img
          src="/assets/img/projects/autonomous-shuttle/SE-5076ee58-3a46-48e5-8f8a-213687567468.jpg"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </span>
      <span class="project-card__body">
        <small>C++, ROS2, UDP, LiDAR</small>
        <strong>자율주행 셔틀: FSM 제어와 시스템 진단</strong>
        <span>인천국제공항 자율주행 셔틀 프로젝트 상세보기</span>
      </span>
    </a>
  </section>

  <section class="landing-portfolio">
    <h2 class="section-title">포트폴리오</h2>
    <PortfolioAccordion projects={projects} />
  </section>

  <article class="landing-document prose">
    <slot />
  </article>
</BaseLayout>
