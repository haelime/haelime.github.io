---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const headings = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{headings.length > 0 && (
  <nav class="toc" aria-label="목차">
    <strong>목차</strong>
    <ol>
      {headings.map((heading) => (
        <li class:list={{ 'toc-depth-3': heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
